<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Playlists, logos and streams from the servers you add. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keeps Wi-Fi awake while a stream plays (Media3 wake mode), so long viewing is not cut by Wi-Fi power saving. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Notices when the network comes back after a drop, to reconnect at once. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Made for TVs, but installs on boxes and phones too; on a phone every screen is landscape, like the TV. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      usesCleartextTraffic: most IPTV panels and playlists are plain http.
      allowBackup off: logins and playlist links never leave the TV in a backup.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Iptv"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity" android:screenOrientation="sensorLandscape"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- CleanYourTV module card, spec 1 (docs/specs/card.md): same activity as LEANBACK_LAUNCHER. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <activity android:name=".pair.PairActivity" android:exported="false" android:screenOrientation="sensorLandscape" />
        <activity android:name=".ui.PlaylistsActivity" android:screenOrientation="sensorLandscape" android:exported="false" />
        <activity android:name=".ui.PlaylistEditActivity" android:screenOrientation="sensorLandscape" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".player.PlayerActivity" android:screenOrientation="sensorLandscape"
            android:exported="false"
            android:theme="@style/Theme.Iptv.Player"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation" />
    </application>
</manifest>
