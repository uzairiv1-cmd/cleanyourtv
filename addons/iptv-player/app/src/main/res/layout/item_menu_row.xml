<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="28dp"
    android:background="@drawable/bg_menu_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="10dp">

    <TextView android:id="@+id/number" android:layout_width="22dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/text_dim" android:textSize="10sp" android:textStyle="bold" />
    <ImageView android:id="@+id/image" android:layout_width="26dp" android:layout_height="17dp" android:layout_marginStart="9dp" android:background="@drawable/round_clip" android:importantForAccessibility="no" android:scaleType="fitCenter" />
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:maxWidth="190dp" android:ellipsize="end" android:singleLine="true" android:textColor="@color/text" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/star" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="★" android:textColor="@color/orange" android:textSize="10sp" />
    <TextView android:id="@+id/prog" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="#FFB8BCC4" android:textSize="11sp" />
    <TextView android:id="@+id/left" android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/orange_light" android:textSize="11sp" android:textStyle="bold" />
    <ProgressBar android:id="@+id/mini" style="?android:attr/progressBarStyleHorizontal" android:layout_width="27dp" android:layout_height="4dp" android:layout_marginStart="9dp" android:max="1000" android:progressDrawable="@drawable/progress_orange" />
</LinearLayout>
