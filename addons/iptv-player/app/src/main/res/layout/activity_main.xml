<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Side menu: the AV mark, then one icon per section. -->
        <LinearLayout
            android:id="@+id/rail"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/fade_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="26dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="29dp"
                android:layout_marginBottom="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/av_logo" />

            <ImageView android:id="@+id/rail_home" style="@style/RailItem" android:contentDescription="@string/nav_home" android:src="@drawable/ic_home" />
            <ImageView android:id="@+id/rail_live" style="@style/RailItem" android:contentDescription="@string/tab_live" android:src="@drawable/ic_live" />
            <ImageView android:id="@+id/rail_movies" style="@style/RailItem" android:contentDescription="@string/tab_movies" android:src="@drawable/ic_movies" />
            <ImageView android:id="@+id/rail_series" style="@style/RailItem" android:contentDescription="@string/tab_series" android:src="@drawable/ic_series" />
            <ImageView android:id="@+id/rail_search" style="@style/RailItem" android:contentDescription="@string/nav_search" android:src="@drawable/ic_search" />
            <ImageView android:id="@+id/rail_settings" style="@style/RailItem" android:contentDescription="@string/nav_settings" android:src="@drawable/ic_settings" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="35dp"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <!-- Start screen, shown while the first lists load. -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="260dp"
            android:layout_height="186dp"
            android:importantForAccessibility="no"
            android:src="@drawable/av_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.4"
            android:text="@string/loading_channels"
            android:textColor="@color/grey_v"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="13dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:id="@+id/splash_progress"
            android:progressDrawable="@drawable/progress_orange" />
    </LinearLayout>
</FrameLayout>
