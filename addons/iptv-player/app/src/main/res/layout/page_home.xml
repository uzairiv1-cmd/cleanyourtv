<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="35dp"
        android:paddingBottom="30dp">

        <TextView android:id="@+id/greeting" style="@style/Cap" android:textColor="@color/text_dim" />
        <TextView android:id="@+id/title" style="@style/PageTitle" android:textSize="33sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="18dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.45"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/round_clip"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/fade_card" />

                <LinearLayout
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="20dp"
                    android:orientation="vertical">

                    <TextView android:id="@+id/hero_cap" style="@style/Cap" />
                    <TextView
                        android:id="@+id/hero_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/hero_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp" />
                    <ProgressBar
                        android:id="@+id/hero_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="200dp"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="10dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/progress_orange" />
                    <TextView
                        android:id="@+id/hero_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button"
                        android:duplicateParentState="true"
                        android:paddingStart="16dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp"
                        android:textColor="#FF111111"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="vertical">

                <include android:id="@+id/door_live" layout="@layout/item_door" />
                <Space android:layout_width="1dp" android:layout_height="10dp" />
                <include android:id="@+id/door_movies" layout="@layout/item_door" />
                <Space android:layout_width="1dp" android:layout_height="10dp" />
                <include android:id="@+id/door_series" layout="@layout/item_door" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/cap_channels" style="@style/Cap" android:layout_marginTop="22dp" android:text="@string/favourite_channels" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/row_channels" style="@style/Row" />

        <TextView android:id="@+id/cap_recent" style="@style/Cap" android:layout_marginTop="16dp" android:text="@string/recently_watched" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/row_recent" style="@style/Row" />

        <TextView android:id="@+id/cap_shows" style="@style/Cap" android:layout_marginTop="16dp" android:text="@string/favourite_shows" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/row_shows" style="@style/Row" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_glass"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:text="@string/home_hint"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
