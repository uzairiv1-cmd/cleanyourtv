<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:show_buffering="never"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/orange"
        android:visibility="gone" />

    <!-- Shown while the stream is being reopened after a drop or a freeze. -->
    <TextView
        android:id="@+id/reconnect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_card_dark"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/orange_light"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Controls: fades, top-right buttons, centre buttons, bottom bar. -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View android:layout_width="match_parent" android:layout_height="130dp" android:background="@drawable/fade_top" />
        <View android:layout_width="match_parent" android:layout_height="150dp" android:layout_gravity="bottom" android:background="@drawable/fade_bottom" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="35dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:layout_marginEnd="14dp"
                android:alpha="0.9"
                android:importantForAccessibility="no"
                android:src="@drawable/av_logo" />
            <ImageView android:id="@+id/btn_tracks" style="@style/RoundIcon" android:contentDescription="@string/options" android:src="@drawable/ic_cc" />
            <ImageView android:id="@+id/btn_list" style="@style/RoundIcon" android:layout_marginStart="8dp" android:contentDescription="@string/channels" android:src="@drawable/ic_list" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView android:id="@+id/btn_prev" style="@style/RoundIcon" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:contentDescription="@string/previous" android:src="@drawable/ic_prev" />
            <ImageView
                android:id="@+id/btn_play"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginStart="35dp"
                android:layout_marginEnd="35dp"
                android:background="@drawable/bg_circle_orange"
                android:contentDescription="@string/play_pause"
                android:focusable="true"
                android:padding="20dp"
                android:src="@drawable/ic_pause" />
            <ImageView android:id="@+id/btn_next" style="@style/RoundIcon" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:contentDescription="@string/next" android:src="@drawable/ic_next" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="35dp"
            android:layout_marginEnd="35dp"
            android:layout_marginBottom="26dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/seek_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:id="@+id/time_now" style="@style/PlayerSmall" />
                <ProgressBar
                    android:id="@+id/seek"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_orange" />
                <TextView android:id="@+id/time_left" style="@style/PlayerSmall" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include android:id="@+id/bottom_live" layout="@layout/part_live_badge" />
                <TextView android:id="@+id/position" style="@style/PlayerSmall" android:layout_marginStart="12dp" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/hints" style="@style/PlayerSmall" android:textColor="#BBFFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Channel banner, shown on every change of channel. -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="35dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_card_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="11dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/banner_logo"
            android:layout_width="55dp"
            android:layout_height="37dp"
            android:background="@drawable/round_clip"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:id="@+id/banner_cap" style="@style/Cap" />
            <TextView
                android:id="@+id/banner_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <include android:id="@+id/banner_live" layout="@layout/part_live_badge" />
    </LinearLayout>

    <TextView
        android:id="@+id/flash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card_dark"
        android:paddingStart="18dp"
        android:paddingTop="9dp"
        android:paddingEnd="18dp"
        android:paddingBottom="9dp"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Channel list panel. -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <TextView android:id="@+id/drawer_cap" style="@style/Cap" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/channels"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawer_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- Error card. -->
    <LinearLayout
        android:id="@+id/error"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card_dark"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <TextView android:id="@+id/error_retry" style="@style/ButtonOrange" android:text="@string/try_again" />
            <TextView android:id="@+id/error_next" style="@style/ButtonGlass" android:layout_marginStart="8dp" android:text="@string/next_channel" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
