<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="575dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="vertical">

    <!-- Tab: the group, "TV guide · channel", or "Groups". -->
    <TextView
        android:id="@+id/panel_tab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:background="@drawable/bg_tab"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="10sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay"
        android:padding="6dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/panel_list"
            android:layout_width="match_parent"
            android:layout_height="336dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/panel_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The coloured remote keys; tappable on touch screens. -->
    <LinearLayout
        android:id="@+id/panel_legend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="11dp"
        android:background="@drawable/bg_tab_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />
</LinearLayout>
