<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="80dp"
    android:paddingEnd="80dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipChildren="false"
        android:orientation="vertical">

        <ImageView
            android:layout_width="62dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:src="@drawable/av_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/pair_title"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/pair_sub"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <TextView style="@style/PairStep" android:text="@string/pair_step1" />
            <TextView style="@style/PairStep" android:text="@string/pair_step2" />
            <TextView
                android:id="@+id/address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="monospace"
                android:textColor="@color/orange_light"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView style="@style/PairStep" android:text="@string/pair_step3" />
            <TextView
                android:id="@+id/code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/orange_light"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_close"
            style="@style/ButtonGlass"
            android:layout_marginTop="18dp"
            android:text="@string/pair_close" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginStart="40dp"
        android:background="@drawable/bg_qr"
        android:padding="14dp">

        <ImageView
            android:id="@+id/qr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/pair_qr" />
    </FrameLayout>
</LinearLayout>
